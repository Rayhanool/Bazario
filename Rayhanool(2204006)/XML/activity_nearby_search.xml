<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bazario_bg">
 <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:background="@color/white">
  <TextView android:id="@+id/back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="←" android:textSize="28sp" android:textColor="@color/bazario_navy"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:text="Nearby Sellers" android:textSize="19sp" android:textStyle="bold" android:textColor="@color/bazario_navy"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
  <EditText android:id="@+id/query" android:layout_width="match_parent" android:layout_height="52dp" android:hint="Product e.g. Rice" android:singleLine="true" android:background="@drawable/bg_input" android:paddingHorizontal="14dp"/>
  <EditText android:id="@+id/area" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:hint="Area e.g. Gazipur" android:singleLine="true" android:background="@drawable/bg_input" android:paddingHorizontal="14dp"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/search" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:text="Find Sellers"/>
 </LinearLayout>
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <LinearLayout android:id="@+id/results" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"/>
 </ScrollView>
</LinearLayout>